# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN DASHBOARD CREDENTIALS
# Configure your private administrative user & password
ADMIN_USERNAME="admin_pedago"
ADMIN_EMAIL="bilingua.agency@gmail.com"
ADMIN_PASSWORD="PedagoAdmin#2026!"

# LEADS_WEBHOOK_URL: Optional webhook URL (Google Apps Script, Zapier, Make, Discord, Slack, etc.)
# Automatically forwards every new teacher registration / lead to your CRM, Google Sheet, Discord channel, etc.
LEADS_WEBHOOK_URL=""

# TELEGRAM NOTIFICATIONS (Instant alert on your smartphone & computer)
# 1. Create a bot in 1 minute with @BotFather on Telegram to get your bot token.
# 2. Start your bot or message @userinfobot to get your Telegram chat ID.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
